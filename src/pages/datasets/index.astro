---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const datasets = (await getCollection('datasets')).sort((a, b) => a.data.name.localeCompare(b.data.name));
---
<Base title="Datasets" description="The catalogue of datasets of the sample center.">
  <h1>Datasets</h1>
  <ul class="cards">
    {datasets.map((d) => (
      <li><a href={`${base}/datasets/${d.id}/`}>{d.data.name}</a><div class="meta">{d.data.summary}</div></li>
    ))}
  </ul>
</Base>
