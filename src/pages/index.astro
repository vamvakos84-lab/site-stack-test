---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import publications from '../data/publications.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const people = (await getCollection('people')).filter((p) => !p.data.former);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const datasets = await getCollection('datasets');
---
<Base title="Home">
  <h1>A sample site to test how pages are made from forms</h1>
  <p>{people.length} people, {datasets.length} datasets, {news.length} news items and {publications.items.length} publications. Every number on this line is counted from the content, not typed by hand.</p>
  <h2>Latest news</h2>
  <ul class="cards">
    {news.slice(0, 3).map((n) => (
      <li><a href={`${base}/news/${n.id}/`}>{n.data.title}</a><div class="meta">{n.data.date.toISOString().slice(0, 10)}</div></li>
    ))}
  </ul>
</Base>
